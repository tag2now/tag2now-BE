      "reservation__models__CreateCommentRequest": {
        "description": "Whitespace is stripped before the length rules run.\n\nA body of three spaces is an empty comment; letting min_length see it\nunstripped would store one, because the service strips on the way to the\nrepository either way.",
        "properties": {
          "body": {
            "maxLength": 500,
            "minLength": 1,
