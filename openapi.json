    "/history/players/{npid}": {
      "get": {
        "description": "Return aggregated history stats for a player.",
        "operationId": "player_history_history_players__npid__get",
        "parameters": [
          {
            "description": "Player NPID",
            "in": "path",
            "name": "npid",
            "required": true,
            "schema": {
              "description": "Player NPID",
              "title": "Npid",
              "type": "string"
            }
          },
          {
            "description": "Number of days",
            "in": "query",
            "name": "days",
            "required": false,
            "schema": {
              "default": 30,
              "description": "Number of days",
              "maximum": 90,
              "minimum": 1,
