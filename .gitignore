.claude
.idea
.venv

# Environment files hold per-deployment config and credentials, and are
# supplied by the runtime — never baked into the image. Only the template
# is tracked.
env/.env*
!env/.env.example
# compose.prod.yml reads ./.env.prod from the repository root on the instance.
.env
.env.*
# Python build artifacts
__pycache__/
*.pyc
*.py[cod]
*.egg-info/

# Generated protobuf file (regenerate with grpc_tools.protoc)
src/rpcn_client/np2_structs_pb2.py
