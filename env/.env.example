# Copy to env/.env.dev (compose, whose defaults these are) or env/.env.local (venv); both are gitignored.
# Outside compose write 127.0.0.1, not localhost: it tries ::1 first and each connection stalls 21s.

# --- RPCN (required, no defaults) -------------------------------------------
# Credentials are not distributed with the repository. Ask a maintainer, or
# register an account at https://rpcn.tag2now.click
RPCN_USER=
RPCN_PASSWORD=
RPCN_TOKEN=
RPCN_HOST=rpcn.tag2now.click
RPCN_PORT=31313

# --- Account login ------------------------------------------------------------
# Signed-in routes answer 502 until all three are set. Spec: docs/spec/07-auth.md
# The URL is plain HTTP: point it at 127.0.0.1 or an HTTPS proxy, never the open internet.
RPCN_API_SERVER_URL=
RPCN_API_SERVER_KEY=
# At least 32 bytes: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# JWT_TTL_SECONDS=604800

# --- TTT2 save admin ----------------------------------------------------------
# /admin/saves/* answers 502 until both are set. Spec: docs/spec/09-save-admin.md
# Key: python -c "import secrets; print(secrets.token_hex(32))"
SAVE_ADMIN_URL=
SAVE_ADMIN_KEY=

# --- Cache ------------------------------------------------------------------
# Empty caches in-process. Set, and startup fails if Redis cannot be reached.
REDIS_URL=
CACHE_TTL_SERVERS=3600
CACHE_TTL_LEADERBOARD=300
CACHE_TTL_ROOMS_ALL=10

# --- Ranking ----------------------------------------------------------------
# RPCN usernames hidden from every ranking; JSON list, case-insensitive.
# RANKING_EXCLUDED_NPIDS=["test_account_1","test_account_2"]

# --- Rank event -------------------------------------------------------------
# The deadline, with its offset; unset, the event keeps running.
# EVENT_END_AT=2026-11-01T00:00:00+09:00

# The saves as the event began, as JSON; unset or unreadable, /event answers 404.
# EVENT_BASELINE_PATH=/event/baseline.json

# --- Database ---------------------------------------------------------------
# DB_URL is host:port only, never a full DSN: the scheme and credentials are
# added from DB_USER/DB_PASSWORD/DB_NAME.
DB_URL=postgres:5432
DB_USER=tag2now
DB_PASSWORD=tag2now
DB_NAME=tag2now
