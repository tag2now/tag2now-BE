# Template for the env/.env.<profile> files.
#
#   cp env/.env.example env/.env.dev     # docker compose stack
#   cp env/.env.example env/.env.local   # local venv run
#
# The copies are gitignored — never commit real values.
# Defaults below match the docker compose stack (compose.yml).
#
# Outside the stack, write 127.0.0.1 rather than localhost: it resolves to ::1
# first, where Docker's published port never answers, costing 21s per connection.

# --- RPCN (required, no defaults) -------------------------------------------
# Credentials are not distributed with the repository. Ask a maintainer, or
# register an account at https://rpcn.tag2now.click
RPCN_USER=
RPCN_PASSWORD=
RPCN_TOKEN=
RPCN_HOST=rpcn.tag2now.click
RPCN_PORT=31313

# --- Account login ------------------------------------------------------------
# rpcn-narco's API server checks passwords (rpcn.cfg: ApiServer=true and
# ApiServerApiKey). The URL is just scheme, host and ApiServerPort, no path. It
# is plain HTTP, so point this at 127.0.0.1 or at an HTTPS proxy, never at the
# open internet. Login and every signed-in route answer 502 while any of the
# three below is empty.
RPCN_API_SERVER_URL=
RPCN_API_SERVER_KEY=
# At least 32 bytes: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it signs every user out.
JWT_SECRET=
# JWT_TTL_SECONDS=604800

# --- TTT2 save admin ----------------------------------------------------------
# tag2now-save-admin's server. In production compose.prod.yml sets the URL to
# http://save-admin:8000 and passes this key to that service as well; generate
# it with: python -c "import secrets; print(secrets.token_hex(32))"
# The /admin/saves/* routes answer 502 while either is empty.
SAVE_ADMIN_URL=
SAVE_ADMIN_KEY=

# --- Cache ------------------------------------------------------------------
# Leave REDIS_URL empty to cache in-process instead (single process only).
# When it is set, startup fails if Redis cannot be reached.
# compose stack: redis://redis:6379 — local venv: redis://127.0.0.1:6379
REDIS_URL=redis://redis:6379
CACHE_TTL_SERVERS=3600
CACHE_TTL_LEADERBOARD=300
CACHE_TTL_ROOMS=10
CACHE_TTL_ROOMS_ALL=10

# --- Ranking ----------------------------------------------------------------
# RPCN usernames (npid) hidden from 주간 철악귀, e.g. test accounts. JSON list,
# case-insensitive. Read at startup; the cached ranking can lag up to 300s.
# RANKING_EXCLUDED_NPIDS=["test_account_1","test_account_2"]

# --- Database ---------------------------------------------------------------
# DB_URL is either a full DSN (postgresql://user:pass@host:port/name) or a bare
# host:port, in which case DB_USER/DB_PASSWORD/DB_NAME are used to build it.
# host:port only — credentials come from DB_USER/DB_PASSWORD/DB_NAME
DB_URL=postgres:5432
DB_USER=tag2now
DB_PASSWORD=tag2now
DB_NAME=tag2now

# Community board backend only — history and reservations always use PostgreSQL.
DB_TYPE=dynamodb

# Used only when DB_TYPE=dynamodb.
DYNAMODB_REGION=ap-northeast-2
DYNAMODB_TABLE_NAME=tag2now-community
DYNAMODB_ENDPOINT_URL=http://dynamodb-local:8000
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
