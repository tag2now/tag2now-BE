# Template for the env/.env.<profile> files.
#
#   cp env/.env.example env/.env.dev     # docker compose stack
#   cp env/.env.example env/.env.local   # local venv run
#
# The copies are gitignored — never commit real values.
# Defaults below match the docker compose stack (compose.yml).

# --- RPCN (required, no defaults) -------------------------------------------
# Credentials are not distributed with the repository. Ask a maintainer, or
# register an account at https://rpcn.tag2now.click
RPCN_USER=
RPCN_PASSWORD=
RPCN_TOKEN=
RPCN_HOST=rpcn.tag2now.click
RPCN_PORT=31313

# --- Cache (REDIS_URL required) ---------------------------------------------
# compose stack: redis://redis:6379 — local venv: redis://localhost:6379
REDIS_URL=redis://redis:6379
CACHE_TTL_SERVERS=3600
CACHE_TTL_LEADERBOARD=60
CACHE_TTL_ROOMS=10
CACHE_TTL_ROOMS_ALL=10

# --- Database ---------------------------------------------------------------
# DB_URL is either a full DSN (postgresql://user:pass@host:port/name) or a bare
# host:port, in which case DB_USER/DB_PASSWORD/DB_NAME are used to build it.
DB_URL=postgresql://tag2now:tag2now@postgres:5432/tag2now

# Community board backend only — history and reservations always use PostgreSQL.
# Keep this `postgresql`: reservation/db.py refuses to start otherwise
# ("Reservations require PostgreSQL").
DB_TYPE=postgresql

# Used only when DB_TYPE=dynamodb.
DYNAMODB_REGION=ap-northeast-2
DYNAMODB_TABLE_NAME=tag2now-community
DYNAMODB_ENDPOINT_URL=http://dynamodb-local:8000
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
